# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Asaas API (Opcional / Financeiro)
ASAAS_API_KEY=your-asaas-api-key
ASAAS_BASE_URL=https://api.asaas.com/v3

# Google Calendar OAuth (Opcional / Agenda)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN_AGENCIAPRATIC=
GOOGLE_REFRESH_TOKEN_PRATICLABS=

# Groq API (Opcional / Notas por Áudio: transcrição + organização com IA)
GROQ_API_KEY=your-groq-api-key

# Web Push / VAPID (Notificações push do PWA)
# Gerar o par com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:contato@agenciapratic.com
