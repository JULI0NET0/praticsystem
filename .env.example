# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Asaas API (Opcional / Financeiro)
ASAAS_API_KEY=your-asaas-api-key
ASAAS_BASE_URL=https://api.asaas.com/v3

# Google Calendar OAuth (Opcional / Agenda)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN_AGENCIAPRATIC=
GOOGLE_REFRESH_TOKEN_PRATICLABS=

# Groq API (Opcional / Notas por Áudio: transcrição + organização com IA)
GROQ_API_KEY=your-groq-api-key

# Web Push / VAPID (Notificações push do PWA)
# Gerar o par com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:contato@agenciapratic.com

# Instagram Automation (área pessoal @juli0net0 / substituto do ManyChat)
IG_APP_ID=your-instagram-app-id
IG_APP_SECRET=your-instagram-app-secret
IG_WEBHOOK_VERIFY_TOKEN=your-random-webhook-verify-token
IG_OAUTH_REDIRECT_URI=https://your-domain/api/instagram/oauth/callback
IG_ADMIN_PASSWORD=your-panel-password
IG_CRON_SECRET=your-random-cron-secret
IG_SESSION_SECRET=your-random-session-secret
IG_HOURLY_SEND_CAP=60
